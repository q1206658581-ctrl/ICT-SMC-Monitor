{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ICT Radar",
  "version": "0.1.0",
  "identifier": "com.ict-monitor.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "pnpm build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ICT Radar",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool"
  }
}
